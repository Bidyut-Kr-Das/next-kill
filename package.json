{
  "name": "cache-kill",
  "version": "0.1.0",
  "description": "Find and delete build and cache folders fast: .next, .nuxt, target, __pycache__, .gradle and more. Like npkill, for build output.",
  "type": "module",
  "bin": {
    "cache-kill": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/*.test.*"
  ],
  "engines": {
    "node": ">=18.14"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/*.test.js",
    "bench": "tsc && node bench/bench.mjs",
    "prepare": "tsc"
  },
  "keywords": [
    "cache",
    "clean",
    "build",
    "disk",
    "cli",
    "npkill",
    "next",
    "nextjs",
    "nuxt",
    "sveltekit",
    "angular",
    "rust",
    "python",
    "gradle",
    "flutter",
    "dotnet"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bidyut-Kr-Das/cache-kill.git"
  },
  "homepage": "https://github.com/Bidyut-Kr-Das/cache-kill#readme"
}
